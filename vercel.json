{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/process(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/clips(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/health",
      "dest": "backend/main.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "^/$",
      "dest": "static/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "static/$1"
    }
  ]
}
