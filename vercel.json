{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(upload|status|results|outputs)",
      "dest": "/main.py"
    },
    {
      "src": "/(upload|status|results|outputs)/(.*)",
      "dest": "/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
